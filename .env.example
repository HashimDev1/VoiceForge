# VoiceForge Studio Environment Variables
# Primary TTS & Voice Cloning API Key (https://fish.audio)
FISH_API_KEY=YOUR_FISH_AUDIO_API_KEY_HERE

# Free Blazing-Fast Speech-to-Text Whisper AI (100% Free at https://console.groq.com/keys)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Optional OpenAI API Key (Whisper & Contextual Translation)
OPENAI_API_KEY=

PORT=5000
NODE_ENV=development
MAX_CONCURRENT_TTS=2
STORAGE_DIR=./temp_storage
